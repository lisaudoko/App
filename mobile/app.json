{
  "expo": {
    "name": "TRU Performance",
    "slug": "tru-performance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "scheme": "truperformance",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.truperformance.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Used to upload athlete profile photos",
        "NSPhotoLibraryUsageDescription": "Used to upload athlete profile photos",
        "NSCalendarsUsageDescription": "TRU Performance needs access to add training sessions and meets to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "TRU Performance needs access to add training sessions and meets to your calendar."
      }
    },
    "android": {
      "package": "com.truperformance.app",
      "versionCode": 1,
      "icon": "./assets/favicon.png",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0b0b0c"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/favicon.png",
          "color": "#111111"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "TRU Performance needs access to add training sessions and meets to your calendar."
        }
      ],
      "expo-font",
      "expo-router",
      "expo-sharing",
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a60ed22-53a7-4444-8b79-ca96e2dd7a6a"
      }
    },
    "owner": "lisaudoko"
  }
}
