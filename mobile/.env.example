# Copy this file to .env and fill in real values. Never commit .env.
# Client-safe vars MUST be prefixed EXPO_PUBLIC_ — Expo inlines those into the
# JS bundle. Anything without that prefix (service role key, Anthropic key)
# must only ever be set as a Supabase Edge Function secret, never here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only at build/config time (app.config.js) to set the EAS project id
# for push notifications. Not exposed to the client bundle directly.
EXPO_PROJECT_ID=your-eas-project-id

# RevenueCat public SDK keys (safe client-side — these only identify the app,
# not a secret). Real purchases require an EAS dev/production build; in Expo
# Go the SDK falls back to a mocked Preview API Mode automatically.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Edge function secrets (set via `supabase secrets set`, NOT read from
# this file by the app). Listed here for reference only:
# SUPABASE_SERVICE_ROLE_KEY
# ANTHROPIC_API_KEY
# REVENUECAT_WEBHOOK_SECRET   -- the shared secret you configure on the
#                                RevenueCat webhook (Authorization header method)
